# APP_URL: The URL where this applet is hosted.
APP_URL=""

# Set to 1 only when HTTPS terminates at a trusted reverse proxy.
GEV_PROVIDER_SETTINGS_TRUST_PROXY="0"

# Optional FastAPI provider key shown in the POWER UP panel.
FASTAPI_API_KEY=""

# Optional: direct Google Photorealistic 3D Tiles and GEV place search.
GOOGLE_MAPS_API_KEY=""

# Optional: Google Photorealistic 3D Tiles through Cesium ion, Bing world imagery, and Cesium World Terrain.
CESIUM_ION_TOKEN=""

# God’s Eye AI provider: "openai" (default) or "openrouter".
GEV_AI_PROVIDER="openai"

# OpenAI Realtime voice/control; this stays server-side and is never sent to the browser.
OPENAI_API_KEY=""

# OpenRouter chat provider (browser speech recognition and speech synthesis are used for voice).
OPENROUTER_API_KEY=""
OPENROUTER_MODEL="openrouter/free"

# Optional: Meteosource live point weather for local thematic heatmaps.
METEOSOURCE_API_KEY=""

# Optional: OpenSky OAuth credentials
OPENSKY_AUTH_MODE="oauth"
OPENSKY_CLIENT_ID=""
OPENSKY_CLIENT_SECRET=""

# Optional: higher Launch Library 2 request allowance. Public access works without a token.
LL2_API_TOKEN=""

# Optional: NASA FIRMS live active fires. Free key from https://firms.modaps.eosdis.nasa.gov/api/map_key/
FIRMS_MAP_KEY=""

# Optional: Private AISStream key for live vessel tracking
AISSTREAM_API_KEY=""

# Optional: TomTom live traffic flow (developer.tomtom.com)
TOMTOM_API_KEY=""

# Optional (India & Asia): ISRO Bhuvan Geo-Platform API key (bhuvan.nrsc.gov.in) for Indian satellite imagery, thematic layers & disaster monitoring
BHUVAN_API_KEY=""

# Optional (India & Asia): WAQI / AQICN Token (aqicn.org/api) for real-time India Air Quality Index (AQI) from CPCB stations across Indian cities
WAQI_API_TOKEN=""

# Optional (India & Asia): Mappls / MapmyIndia API Key or Client ID (mappls.com) for Indian street-level geospatial navigation, pin codes & POIs
MAPPLS_API_KEY=""
MAPPLS_CLIENT_ID=""
MAPPLS_CLIENT_SECRET=""

# Optional (India & Asia): OpenWeather API Key (openweathermap.org) for South Asia monsoon, precipitation radar & Indian Ocean cyclone tracking
OPENWEATHER_API_KEY=""

# Optional (India & Asia): Open Government Data India API Key (data.gov.in) for Indian Railways, ports, power stations & infrastructure
DATA_GOV_IN_API_KEY=""

# Optional: OpenTopography API Key (opentopography.org) for high-resolution Copernicus 30m DEM & contour telemetry
OPENTOPOGRAPHY_API_KEY=""
